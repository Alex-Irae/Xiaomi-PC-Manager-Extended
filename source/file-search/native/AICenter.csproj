<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget><AssemblyName>AI Center</AssemblyName><Version>0.3.2</Version>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <WebViewReferenceDir Condition="'$(WebViewReferenceDir)' == ''">C:\Utils\XiaomiPc Manager\development\XiaomiAIManager\app</WebViewReferenceDir>
  </PropertyGroup>
  <!-- Existing installed assemblies, no NuGet package download or installation. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\app.ico" LogicalName="LocalAICenter.App.ico" />
    <Reference Include="Microsoft.Web.WebView2.Core"><HintPath>$(WebViewReferenceDir)\Microsoft.Web.WebView2.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms"><HintPath>$(WebViewReferenceDir)\Microsoft.Web.WebView2.WinForms.dll</HintPath><Private>true</Private></Reference>
    <Content Include="$(WebViewReferenceDir)\runtimes\win-x64\native\WebView2Loader.dll" Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Compile Include="..\..\shared\SuiteLink.cs" Link="SuiteLink.cs" /><Compile Include="..\..\shared\ShortcutRecorder.cs" Link="ShortcutRecorder.cs" /></ItemGroup>
</Project>
