<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PCManager</AssemblyName>
    <AssemblyTitle>PC Manager</AssemblyTitle>
    <Product>PC Manager</Product>
    <Description>PC Manager quick controls and hardware settings</Description>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Version>0.1.5</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);.test-environment\**;app\**;results\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="installer\**\*.cs" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Svg" Version="3.4.7" />
    <EmbeddedResource Include="Vendor\XiControl\Localization\en.json" LogicalName="lang.en.json" />
    <EmbeddedResource Include="Vendor\XiControl\Assets\svg\*.svg" LogicalName="svg.%(Filename).svg" />
    <EmbeddedResource Include="Vendor\XiControl\Assets\sound\*.wav" LogicalName="sound.%(Filename).wav" />
    <Content Include="www\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="assets\**\*" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <Content Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tools\oem-service.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Disable Xiaomi service.cmd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Restore Xiaomi service.cmd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="packaging\uninstall.ps1" Link="Uninstall PC Manager.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="installer\Install.ps1" Link="Install PC Manager.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
