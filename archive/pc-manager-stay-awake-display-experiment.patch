# Unreleased PC Manager experiment from 5 October 2026: a setting "Keep display on during Stay awake"
# (OwlIgnoreDisplay, a one-time migration, and a fallback that also keeps the display awake).
# It lived only in the old Development\PC Manager test copy, which was removed on 6 October 2026.
# This is a diff from the released 0.3.6 source to that copy. Lines it removes are newer released work:
# apply the added lines by hand, do not apply the file as a whole.

--- a/source/pc-manager/ManagerApplication.cs
+++ b/source/pc-manager/ManagerApplication.cs
@@ -385,8 +385,9 @@
         // Turning Stay awake on cancels a Screen off request that has not darkened the display yet.
         if (enabled) ManualDisplay.RestoreIdleLogged();
         if (Advanced is not null) return Advanced.SetAwake(enabled);
-        // Keep this call on the persistent UI thread. It never changes lid or display policy.
-        if (SetThreadExecutionState(enabled ? 0x80000001u : 0x80000000u) == 0)
+        // Keep this call on the persistent UI thread. The fallback must keep
+        // both the system and display awake, like the XiControl control.
+        if (SetThreadExecutionState(enabled ? 0x80000003u : 0x80000000u) == 0)
             throw new InvalidOperationException("Windows did not accept the stay-awake request.");
         fallbackAwake = enabled;
         return new { message = enabled ? "Stay awake is on while the manager runs." : "Stay awake is off.", awake = Awake };
