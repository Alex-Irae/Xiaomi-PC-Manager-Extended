                 preferences.ResidentSetupVersion = 3;
             }
             MigrateF7Default(preferences, config);
+            if (!preferences.StayAwakeDisplayMigrationDone)
+            {
+                // Earlier PC Manager builds inverted this option and defaulted to
+                // allowing display-off. Restore XiControl's screen-awake default once.
+                config.OwlIgnoreDisplay = false;
+                preferences.StayAwakeDisplayMigrationDone = true;
+            }
             if (preferences.ResidentSetupVersion < 5)
             {
                 if (config.AiKeyAction is "none" or "panel") config.AiKeyAction = "xiaoai";
